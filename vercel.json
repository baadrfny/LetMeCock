{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "server.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/server.php" }
  ],
  "buildCommand": "composer install --no-dev --prefer-dist --optimize-autoloader && npm run build",
  "installCommand": "npm install"
}
